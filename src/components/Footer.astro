---
const { lang = "es" } = Astro.props;
const isEs = lang === "es";
---

<footer class="border-t border-azul-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 md:grid-cols-3">
    <div class="space-y-3">
      <p class="font-display text-lg font-semibold text-azul-900">Pole Sport Medellin</p>
      <p class="text-sm text-neutral-600">
        {isEs
          ? "TODO_DIRECCION_COMPLETA - Medellin, Colombia."
          : "TODO_FULL_ADDRESS - Medellin, Colombia."}
      </p>
      <p class="text-sm text-neutral-600">TODO_EMAIL@DOMINIO.COM</p>
    </div>
    <div class="space-y-2 text-sm text-azul-900">
      <p class="font-semibold uppercase tracking-wide text-neutral-500">
        {isEs ? "Explora" : "Explore"}
      </p>
      <a href={isEs ? "/es#programas" : "/en#programs"} class="block hover:text-azul-600">
        {isEs ? "Programas" : "Programs"}
      </a>
      <a href={isEs ? "/es#precios" : "/en#pricing"} class="block hover:text-azul-600">
        {isEs ? "Planes" : "Plans"}
      </a>
      <a href={isEs ? "/es#contacto" : "/en#contact"} class="block hover:text-azul-600">
        {isEs ? "Contacto" : "Contact"}
      </a>
    </div>
    <div class="space-y-3">
      <p class="font-semibold uppercase tracking-wide text-neutral-500">
        {isEs ? "Reserva" : "Book"}
      </p>
      <a
        href="TODO_WHATSAPP_LINK"
        class="inline-flex items-center justify-center rounded-full bg-azul-600 px-4 py-2 text-sm font-semibold text-white hover:bg-turquesa-600"
      >
        {isEs ? "Reserva tu clase de prueba" : "Book your trial class"}
      </a>
      <p class="text-xs text-neutral-500">
        {isEs ? "Horario: TODO_HORARIO" : "Hours: TODO_HOURS"}
      </p>
    </div>
  </div>
  <div class="border-t border-azul-200/60 bg-azul-50">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-4 text-xs text-neutral-500 md:flex-row md:items-center md:justify-between">
      <p>(c) 2025 Pole Sport Medellin. {isEs ? "Todos los derechos reservados." : "All rights reserved."}</p>
      <a href="#" class="hover:text-azul-600">
        {isEs ? "Politica de privacidad (TODO)" : "Privacy policy (TODO)"}
      </a>
    </div>
  </div>
</footer>
