---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Precios Pole Sport Medellin | Planes y Membresias";
const description =
  "Consulta precios y planes de pole fitness en Medellin. Opciones flexibles para todos los niveles. Escribenos para mas detalles.";
const ogTitle = "Precios y planes en Pole Sport Medellin";
const ogDescription =
  "Descubre precios y planes flexibles para clases de pole fitness en Medellin. Escribenos para asesoria personalizada.";
const canonical = "https://TODO_DOMINIO/es/precios";
const hreflang = [
  { lang: "es-CO", href: "https://TODO_DOMINIO/es/precios" },
  { lang: "en", href: "https://TODO_DOMINIO/en/pricing" },
];
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  canonical={canonical}
  lang="es"
  hreflang={hreflang}
>
  <section class="bg-azul-50">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <h1 class="text-4xl font-semibold text-azul-900">
        Conoce nuestros planes y precios de clases en Medellin
      </h1>
      <p class="mt-4 text-neutral-500">
        TODO_DETALLE_PLANES. Escribenos para asesoria personalizada.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="TODO_WHATSAPP_LINK"
          class="inline-flex items-center justify-center rounded-full bg-azul-600 px-6 py-3 text-sm font-semibold text-white hover:bg-turquesa-600"
        >
          Escribenos a TODO_WHATSAPP_NUMERO
        </a>
        <a
          href="/es#precios"
          class="inline-flex items-center justify-center rounded-full border border-azul-600 px-6 py-3 text-sm font-semibold text-azul-600 hover:bg-azul-50"
        >
          Ver planes destacados
        </a>
      </div>
    </div>
  </section>
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="rounded-3xl border border-azul-200 bg-azul-50 p-8 text-neutral-500">
        TODO_TABLA_PRECIOS_COMPLETA
      </div>
      <div class="mt-8 flex flex-col gap-3 text-sm text-azul-900">
        <a href="/es" class="font-semibold hover:text-azul-600">Volver al inicio</a>
        <a href="/es/contactanos" class="font-semibold hover:text-azul-600">Contactanos</a>
      </div>
    </div>
  </section>
</BaseLayout>
