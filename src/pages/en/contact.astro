---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Contact | Pole Sport Medellin";
const description =
  "Message us on WhatsApp or email to book your pole fitness class in Medellin. We're ready to help.";
const ogTitle = "Contact Pole Sport Medellin";
const ogDescription =
  "Reach Pole Sport Medellin and book your trial class via WhatsApp or email.";
const canonical = "https://TODO_DOMINIO/en/contact";
const hreflang = [
  { lang: "es-CO", href: "https://TODO_DOMINIO/es/contactanos" },
  { lang: "en", href: "https://TODO_DOMINIO/en/contact" },
];
---

<BaseLayout
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  canonical={canonical}
  lang="en"
  hreflang={hreflang}
>
  <section class="bg-azul-50">
    <div class="mx-auto max-w-4xl px-6 py-16 text-center">
      <h1 class="text-4xl font-semibold text-azul-900">
        Let's talk and book your class in Medellin
      </h1>
      <p class="mt-4 text-neutral-500">
        Message us on WhatsApp or email to reserve your trial class.
      </p>
      <div class="mt-6 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="TODO_WHATSAPP_LINK"
          class="inline-flex items-center justify-center rounded-full bg-turquesa-600 px-6 py-3 text-sm font-semibold text-white hover:bg-azul-600"
        >
          Chat on WhatsApp: TODO_WHATSAPP_NUMBER
        </a>
        <a
          href="mailto:TODO_EMAIL"
          class="inline-flex items-center justify-center rounded-full border border-azul-600 px-6 py-3 text-sm font-semibold text-azul-600 hover:bg-azul-50"
        >
          Send email
        </a>
      </div>
    </div>
  </section>
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <div class="rounded-3xl border border-azul-200 bg-azul-50 p-8 text-neutral-500">
        TODO_CONTACT_FORM_DETAILS
      </div>
      <div class="mt-8 flex flex-col gap-3 text-sm text-azul-900">
        <a href="/en" class="font-semibold hover:text-azul-600">Back to home</a>
        <a href="/en/pricing" class="font-semibold hover:text-azul-600">View plans</a>
      </div>
    </div>
  </section>
</BaseLayout>
