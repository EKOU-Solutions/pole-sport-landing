---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Navbar } from "../../components/Navbar.tsx";
import { Hero } from "../../components/Hero.tsx";
import { ValueProposition } from "../../components/ValueProposition.tsx";
import { Team } from "../../components/Team.tsx";
import { Pricing } from "../../components/Pricing.tsx";
import { ClassTypes } from "../../components/ClassTypes.tsx";
import { Testimonials } from "../../components/Testimonials.tsx";
import { Contact } from "../../components/Contact.tsx";
import { Location } from "../../components/Location.tsx";
import { Footer } from "../../components/Footer.tsx";
import { AnimatedBackground } from "../../components/AnimatedBackground.tsx";
import copy from "@/content/copy.json";

const title = "Pole Sport Medellin | Pole Fitness Classes";
const description =
  "Learn pole fitness in Medellin with certified instructors. Book a trial class and enjoy a safe, inclusive experience.";
const canonical = "https://TODO_DOMINIO/en";
const keywords =
  "pole fitness, pole dance, pole sport, pole classes, pole studio, Medellin, flexibility, training";
const author = "Pole Sport Medellin";
const ogTitle = "Pole Sport Medellin | Pole Fitness Classes";
const ogDescription =
  "Train pole fitness in Medellin with technique, safety, and an inclusive atmosphere. Book your trial class today.";
const ogImage = "https://TODO_OG_IMAGE";
const ogUrl = canonical;
const twitterSite = "@polesportmed";
const twitterImage = ogImage;
const hreflang = [
  { lang: "es-CO", href: "https://TODO_DOMINIO/es" },
  { lang: "en", href: "https://TODO_DOMINIO/en" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: "Pole Sport Medellin",
  description:
    "Pole fitness studio in Medellin with Pole Sport, Pole Dancing, and Flexibility classes.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Medellin",
    addressRegion: "Antioquia",
    addressCountry: "CO",
  },
  openingHours: ["Mo-Fr 06:00-21:00", "Sa 08:00-14:00"],
  priceRange: "$$",
};

const pageCopy = copy.en;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  author={author}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogUrl={ogUrl}
  twitterSite={twitterSite}
  twitterImage={twitterImage}
  lang="en"
  hreflang={hreflang}
  schema={schema}
>
  <AnimatedBackground />
  <Navbar copy={pageCopy} client:load />
  <Hero copy={pageCopy} client:load />
  <ValueProposition copy={pageCopy} client:load />
  <Team copy={pageCopy} client:load />
  <Pricing copy={pageCopy} client:load />
  <ClassTypes copy={pageCopy} client:load />
  <Testimonials copy={pageCopy} client:load />
  <Contact copy={pageCopy} client:only="react" />
  <Location copy={pageCopy} client:load />
  <Footer copy={pageCopy} />
</BaseLayout>
